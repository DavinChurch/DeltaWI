 :Section ⍝ This section requires even more ⎕WA than is needed for the other operations, so we'll try to catch that here
     :Trap 1 ⍝ Try to trap WS FULL ⍝? This may need to be expanded to include the whole function
         'p'∆WI Pass MT⊢drawclear,('Scale' 5)('Pen' 1(255 0 0)3)('Brush' 1(0 0 128))('Circle' 50 50 50)
         'p'∆WI Pass MT⊢drawclear,('Scale' 5)('Window' 50 100 150 150)('Pen' 1(255 0 0)3)('Brush' 1(0 0 128))('Circle' 50 50 50)
         'p'∆WI Pass MT⊢drawclear,('Scale' 5)('Window' 50 100 75 75)('Pen' 1(255 0 0)3)('Brush' 1(0 0 128))('Circle' 50 50 50)
         'p'∆WI Pass MT⊢drawclear,('Scale' 5)('Clip' 25 25 75 75)('Pen' 1(255 0 0)3)('Brush' 1(0 0 128))('Circle' 50 50 50)
         'p'∆WI Pass MT⊢drawclear,('Scale' 5)('Window' 50 100 150 150)('Clip' 25 25 75 75)('Pen' 1(255 0 0)3)('Brush' 1(0 0 128))('Circle' 50 50 50)
         'p'∆WI Pass MT⊢drawclear,('Mode' 0)('Window' 10 10 10 30)('Font' 'Arial' 1 0 'ansi')('Color'(3⍴255)(3⍴0))('Text' 'This is a test...' 5 5)
         'p'∆WI Pass MT⊢drawclear,('Mode' 0)('Clip' 0 8 10 3)('Font' 'Arial' 1 0 'ansi')('Color'(3⍴255)(3⍴0))('Text' 'This is a test...' 5 5)
         'p'∆WI Pass MT⊢drawclear,('Window' 10 10 10 30)('Bitmap'bmpfile 0 0)
         'p'∆WI Pass MT⊢drawclear,('Window' 10 10 10 30)('Icon'icofile 0 0)
         'p'∆WI Pass MT⊢drawclear,('Scale' 5)('Clip'(3 2⍴5 50,75 5,120 90))('Pen' 1(255 0 0)3)('Brush' 1(0 0 128))('Circle' 50 50 50)
         'p'∆wi Pass{1=≢⍵}⊢'Draw'('?Bitmap'bmpfile) ⋄ bfh←⊃Res
         'p'∆wi Pass{1=≢⍵}⊢'Draw'('?Icon'icofile) ⋄ ifh←⊃Res
         'p'∆WI Pass MT⊢drawclear,⊂('Bitmap'bmpfile 0 0)
         'p'∆WI Pass MT⊢drawclear,⊂('Icon'icofile 0 0)
         'p'∆WI Pass MT⊢drawclear,⊂('Bitmap'bfh 0 0)
         'p'∆WI Pass MT⊢drawclear,⊂('Icon'ifh 0 0)
     :Else
         'WS FULL reported on large-memory operations - tests skipped!'
     :EndTrap
 :EndSection

