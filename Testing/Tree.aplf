 'f.t'∆WI Pass 0 0 0⊢'GetInfo' 'highlightcut'(1 2 3)
 'f.t'∆WI Pass 0 0⊢'GetInfo' 'expanded'(12 3)
 'f.t'∆WI Pass 0 0⊢'GetInfo' 'expandedonce'(12 3)
 'f.t'∆WI Pass 1⊢'Expand' 'expand' 3
 'f.t'∆WI Pass 0 1⊢'GetInfo' 'expanded'(12 3)
 'f.t'∆WI Pass 0 1⊢'GetInfo' 'expandedonce'(12 3)
 'f.t'∆WI Pass 1⊢'Expand' 'collapse' 3
 'f.t'∆WI Pass 0 0⊢'GetInfo' 'expanded'(12 3)
 'f.t'∆WI Pass 0 1⊢'GetInfo' 'expandedonce'(12 3)
 'f.t'∆WI Pass 1 0⊢'GetInfo' 'haschildren'(1 2)

 'f.t'∆WI Pass 1 1⊢'SetInfo' 'checkstate'(2 3)(0 1)
 'f.t'∆WI Pass 0 1⊢'GetInfo' 'checkstate'(2 3)
 'f.t'∆WI Pass(,1)⊢'SetInfo' 'list' 2(1 3⍴'Twoo'(1 1 0 0)'')
 'f.t'∆WI Pass(,⊂'Twoo')⊢'GetInfo' 'label' 2
 'f.t'∆WI Pass(,1)⊢'SetInfo' 'list' 2('Two'(1 1 0 0)'')
 'f.t'∆WI Pass(,1)⊢'SetInfo' 'label' 2 'Too'
 'f.t'∆WI Pass(,⊂'Too')⊢'GetInfo' 'label' 2
 'f.t'∆WI Pass(,1)⊢'SetInfo' 'label'(,2)(1 1⍴⊂'Two')
 'f.t'∆WI Pass(2 4⍴1 1 0 0,1 1 0 0)⊢'GetInfo' 'images'(12 121)
 'f.t'∆WI Pass(,1)⊢'SetInfo' 'images' 12(5 1)
 'f.t'∆WI Pass(2 4⍴5 1 0 0,1 1 0 0)⊢'GetInfo' 'images'(12 121)
 'f.t'∆WI Pass 0 0 0⊢'GetInfo' 'highlightbold'(1 2 3)
 'f.t'∆WI Pass 1 1 1⊢'SetInfo' 'highlightbold'(1 2 3)(0 1 0)
 'f.t'∆WI Pass 0 1 0⊢'GetInfo' 'highlightbold'(1 2 3)
 'f.t'∆WI Pass 0 0 0⊢'GetInfo' 'highlightcut'(1 2 3)
 'f.t'∆WI Pass 1 1 1⊢'SetInfo' 'highlightcut'(1 2 3)(0 1 0)
 'f.t'∆WI Pass 0 1 0⊢'GetInfo' 'highlightcut'(1 2 3)
 'f.t'∆WI Pass 1 1 1⊢'SetInfo' 'highlightcut'(1 2 3)(0 0 0)
 'f.t'∆WI Pass MT⊢'list'(tree[;⍳3])
 'f.t'∆WI Pass{tree[7 8;3 4]≡2↑[2]⍵}⊢'GetInfo' 'list'(2 3)
 'f.t'∆WI Pass 0 0⊢'GetInfo' 'expandedonce'(1 3)
 'f.t'∆WI Pass 1 1⊢'SetInfo' 'expanded'(1 3)(1 0)
 'f.t'∆WI Pass 1 0⊢'GetInfo' 'expanded'(1 3)
